{
    "properties": {
        "connectionParameters": {
            "token": {
                "type": "oauthSetting",
                "oAuthSettings": {
                    "identityProvider": "oauth2generic",
                    "clientId": "[YOUR_CLIENT_ID]",
                    "scopes": [
                        "core:*:*",
                        "users:userdata:read",
                        "users:profile:read",
                        "users:own_profile:read",
                        "organizations:organization:read",
                        "orgunits:course:read",
                        "managecourses:courses:read",
                        "enrollment:own_enrollment:read",
                        "enrollment:orgunit:read",
                        "grades:gradeobjects:read",
                        "grades:gradevalues:read",
                        "grades:gradevalues:write",
                        "grades:gradecategories:read",
                        "content:toc:read",
                        "content:modules:readonly",
                        "content:topics:readonly",
                        "dropbox:folders:read",
                        "news:newsitems:read",
                        "news:newsitems:manage",
                        "discussions:forums:readonly",
                        "discussions:topics:readonly",
                        "discussions:posts:readonly",
                        "quizzing:quizzes:read",
                        "quizzing:attempts:read"
                    ],
                    "redirectMode": "Global",
                    "redirectUrl": "[YOUR_REDIRECT_URL]",
                    "properties": {
                        "IsFirstParty": "False",
                        "IsOnbehalfofLoginSupported": false
                    },
                    "customParameters": {
                        "authorizationUrlTemplate": {
                            "value": "https://auth.brightspace.com/oauth2/auth"
                        },
                        "authorizationUrlQueryStringTemplate": {
                            "value": "client_id={ClientId}&redirect_uri={RedirectUrl}&response_type=code&scope={Scopes}&state={State}"
                        },
                        "tokenUrlTemplate": {
                            "value": "https://auth.brightspace.com/core/connect/token"
                        },
                        "tokenBodyTemplate": {
                            "value": "grant_type=authorization_code&code={Code}&redirect_uri={RedirectUrl}&client_id={ClientId}&client_secret={ClientSecret}"
                        },
                        "refreshUrlTemplate": {
                            "value": "https://auth.brightspace.com/core/connect/token"
                        },
                        "refreshBodyTemplate": {
                            "value": "grant_type=refresh_token&refresh_token={RefreshToken}&client_id={ClientId}&client_secret={ClientSecret}"
                        }
                    }
                }
            }
        },
        "iconBrandColor": "#E87511",
        "capabilities": [
            "actions"
        ],
        "publisher": "Troy Taylor",
        "stackOwner": "D2L Corporation",
        "scriptOperations": [
            "InvokeMCP",
            "FindUserByUsername",
            "FindUsersByOrgDefinedId"
        ]
    }
}
