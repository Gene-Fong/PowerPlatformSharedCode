{
  "properties": {
    "connectionParameters": {
      "token": {
        "type": "oauthSetting",
        "oAuthSettings": {
          "identityProvider": "aad",
          "clientId": "[YOUR_CLIENT_ID]",
          "scopes": [
            "https://api.powerplatform.com/CopilotStudio.Copilots.Invoke offline_access"
          ],
          "redirectMode": "Global",
          "redirectUrl": "[YOUR_REDIRECT_URL]",
          "properties": {
            "IsFirstParty": "False",
            "AzureActiveDirectoryResourceId": "https://api.powerplatform.com"
          },
          "customParameters": {
            "loginUri": {
              "value": "https://login.microsoftonline.com"
            },
            "tenantId": {
              "value": "common"
            },
            "resourceUri": {
              "value": "https://api.powerplatform.com"
            }
          }
        },
        "uiDefinition": {
          "displayName": "OAuth Connection",
          "description": "Sign in with the Microsoft account that has access to the agent. The Agentic Runtime rejects service principal tokens.",
          "constraints": {
            "tabIndex": 1,
            "required": "true"
          }
        }
      },
      "environmentHost": {
        "type": "string",
        "uiDefinition": {
          "displayName": "Environment Host",
          "description": "The Power Platform environment host that serves your agent.",
          "tooltip": "Format: {30 hex characters}.{2 hex characters}.environment.api.powerplatform.com. Take your environment GUID, remove the hyphens, then split the 32 characters after the 30th. Do not include https://.",
          "constraints": {
            "tabIndex": 2,
            "required": "true"
          }
        }
      }
    },
    "iconBrandColor": "#0078D7",
    "capabilities": [],
    "publisher": "Troy Taylor",
    "stackOwner": "Microsoft",
    "policyTemplateInstances": [
      {
        "templateId": "dynamichosturl",
        "title": "Set Environment Host",
        "parameters": {
          "x-ms-apimTemplateParameter.urlTemplate": "https://@connectionParameters('environmentHost')",
          "x-ms-apimTemplate-operationName": [
            "AskAgent",
            "StartConversation",
            "SendMessage",
            "InvokeMCP"
          ]
        }
      }
    ],
    "scriptOperations": [
      "AskAgent",
      "StartConversation",
      "SendMessage",
      "InvokeMCP"
    ]
  }
}
